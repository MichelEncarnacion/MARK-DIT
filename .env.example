# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env con valores reales al repositorio.

# --- LLM propio (ThinkStation PGX / DeepSeek R1 70B) ---
DEEPSEEK_BASE_URL=https://ia.upaep.io/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-r1:70b

# --- Servidor ---
PORT=3000

# --- Token para proteger POST /api/refresh (elige uno propio y seguro) ---
REFRESH_TOKEN=

# --- Zona horaria para el cron diario de las 7:00 AM ---
CRON_TIMEZONE=America/Mexico_City
